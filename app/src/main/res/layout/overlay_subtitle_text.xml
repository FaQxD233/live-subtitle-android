<?xml version="1.0" encoding="utf-8"?>
<!--
    The subtitle player's text window: the current subtitle in video-caption
    style (white text with a black outline, on an optional box), centered.
    The window spans the screen width, so a long subtitle wraps within it
    minus the side margins (a wrap-content window is first laid out at most
    320dp wide, narrow in landscape), and a subtitle of another width
    doesn't move it. It is placed by its bottom edge and the box sits at its
    bottom, so a two-line subtitle grows upwards. Hidden until there is
    something to show (see SubtitlePlayerOverlay.showText).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:visibility="invisible">

    <FrameLayout
        android:id="@+id/subtitleBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/subtitle_box_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <!-- The outline: drawn as a stroke under the fill. -->
        <TextView
            android:id="@+id/subtitleOutline"
            style="@style/SubtitleText"
            android:importantForAccessibility="no"
            android:textColor="#FF000000" />

        <TextView
            android:id="@+id/subtitleText"
            style="@style/SubtitleText"
            android:textColor="#FFFFFFFF" />
    </FrameLayout>
</FrameLayout>
