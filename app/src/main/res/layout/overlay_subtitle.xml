<?xml version="1.0" encoding="utf-8"?>
<!--
    Subtitle player overlay: the current subtitle in video-caption style
    (white text with a black outline, on an optional box) and, while
    unlocked, a control bar below it.

    The top row holds the lock and close buttons. While locked it stays laid
    out but invisible, so the separate unlock button window can sit exactly
    over the lock button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/subtitleTopRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/subtitleLockBtn"
            style="@style/SubtitleControl"
            android:layout_width="32dp"
            android:contentDescription="@string/player_lock"
            android:src="@drawable/ic_overlay_lock" />

        <ImageButton
            android:id="@+id/subtitleCloseBtn"
            style="@style/SubtitleControl"
            android:layout_width="32dp"
            android:layout_marginEnd="0dp"
            android:contentDescription="@string/overlay_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/subtitleBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/subtitle_box_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <!-- The outline: drawn as a stroke under the fill. -->
        <TextView
            android:id="@+id/subtitleOutline"
            style="@style/SubtitleText"
            android:importantForAccessibility="no"
            android:textColor="#FF000000" />

        <TextView
            android:id="@+id/subtitleText"
            style="@style/SubtitleText"
            android:textColor="#FFFFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/subtitleControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/overlay_card_bg"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/subtitleTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/subtitleSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent_bright"
                android:thumbTint="@color/accent_bright" />

            <!-- Briefly names the last shift, e.g. "Subtitles 0.5 s later". -->
            <TextView
                android:id="@+id/subtitleShift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/status_connecting"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/subtitlePrevBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_previous"
                android:src="@android:drawable/ic_media_previous" />

            <Button
                android:id="@+id/subtitleBackBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_back"
                android:padding="0dp"
                android:text="@string/player_back_label" />

            <ImageButton
                android:id="@+id/subtitlePlayBtn"
                style="@style/SubtitleControl"
                android:background="@drawable/overlay_btn_primary"
                android:contentDescription="@string/player_play"
                android:src="@android:drawable/ic_media_play" />

            <Button
                android:id="@+id/subtitleForwardBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_forward"
                android:padding="0dp"
                android:text="@string/player_forward_label" />

            <ImageButton
                android:id="@+id/subtitleNextBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_next"
                android:src="@android:drawable/ic_media_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/subtitleSmallerBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_smaller"
                android:padding="0dp"
                android:text="@string/player_smaller_label" />

            <Button
                android:id="@+id/subtitleLargerBtn"
                style="@style/SubtitleControl"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/player_larger"
                android:padding="0dp"
                android:text="@string/player_larger_label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
