<?xml version="1.0" encoding="utf-8"?>
<!--
    The subtitle player's control window, apart from the subtitle so the
    two never push each other around. Expanded it is a card in the caption
    overlay's style, 300dp wide (narrower on a narrower screen, set in
    code); folded (by hand, or a while into playback) it is only a small
    dot that expands it again on a tap. Both drag the window; the margins
    leave room for the elevation shadows. See docs/plan-player-sync-ui.md,
    4.2 and 4.4.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- The controls folded; its center shows how following goes, as the chip's dot does. -->
    <FrameLayout
        android:id="@+id/playerDot"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="4dp"
        android:background="@drawable/overlay_dot_bg"
        android:contentDescription="@string/overlay_expand"
        android:elevation="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/playerDotState"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/status_dot" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/playerCard"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:background="@drawable/overlay_card_bg"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <!-- Header: the status chip, then more, minimize, close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Leaves the chip its own width, at most what the buttons leave. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <!--
                    Whether and how the subtitles follow the video app, in a
                    word or two; the info line says more. A tap does what is
                    needed now (see the service).
                -->
                <TextView
                    android:id="@+id/playerChip"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/overlay_btn_secondary"
                    android:drawableStart="@drawable/status_dot"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="12sp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/playerMoreBtn"
                style="@style/SubtitleControl"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/player_more"
                android:src="@drawable/ic_more_vert" />

            <ImageButton
                android:id="@+id/playerMinimizeBtn"
                style="@style/SubtitleControl"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/overlay_minimize"
                android:src="@drawable/ic_overlay_minimize" />

            <ImageButton
                android:id="@+id/playerCloseBtn"
                style="@style/SubtitleControl"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/overlay_close"
                android:src="@drawable/ic_overlay_close" />
        </LinearLayout>

        <!-- Progress, and the playback speed next to it -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/playerSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent_bright"
                android:thumbTint="@color/accent_bright" />

            <!-- A tap steps through the speeds, a long press goes back to 1×. -->
            <Button
                android:id="@+id/playerSpeedBtn"
                style="@style/SubtitleControl"
                android:layout_width="44dp"
                android:layout_marginEnd="0dp"
                android:padding="0dp" />
        </LinearLayout>

        <!-- The times, under the ends of the progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="44dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/playerElapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/playerDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/hud_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Previous line, −0.5 s, play, +0.5 s, next line -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/playerPrevBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_previous"
                android:src="@drawable/ic_player_previous" />

            <Button
                android:id="@+id/playerBackBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_back"
                android:padding="0dp"
                android:text="@string/player_back_label" />

            <ImageButton
                android:id="@+id/playerPlayBtn"
                style="@style/SubtitleControl"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:background="@drawable/overlay_btn_primary"
                android:contentDescription="@string/player_play"
                android:src="@drawable/ic_player_play" />

            <Button
                android:id="@+id/playerForwardBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_forward"
                android:padding="0dp"
                android:text="@string/player_forward_label" />

            <ImageButton
                android:id="@+id/playerNextBtn"
                style="@style/SubtitleControl"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/player_next"
                android:src="@drawable/ic_player_next" />
        </LinearLayout>

        <!--
            The info line, always one line high so the card keeps its
            height: a brief note, or how following goes, or the offset from
            the video, with reset beside an offset.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hud_text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/playerResetBtn"
                style="@style/SubtitleControl"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/player_reset_desc"
                android:padding="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/player_reset"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Something to read at more length, with its buttons. -->
        <LinearLayout
            android:id="@+id/playerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/playerPanelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/hud_text_primary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/playerPanelSecondary"
                    style="@style/SubtitleControl"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:padding="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/playerPanelPrimary"
                    style="@style/SubtitleControl"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/overlay_btn_primary"
                    android:padding="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Behind ⋮: following on / off, the text size, the diagnostics readout -->
        <LinearLayout
            android:id="@+id/playerMoreRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/playerFollowBtn"
                style="@style/SubtitleControl"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:contentDescription="@string/player_follow_start"
                android:padding="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/player_follow" />

            <Button
                android:id="@+id/playerSmallerBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_smaller"
                android:padding="0dp"
                android:text="@string/player_smaller_label" />

            <Button
                android:id="@+id/playerLargerBtn"
                style="@style/SubtitleControl"
                android:contentDescription="@string/player_larger"
                android:padding="0dp"
                android:text="@string/player_larger_label" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- The media sessions readout, for measuring (docs/plan-mediasession-sync.md). -->
            <Button
                android:id="@+id/playerSessionsBtn"
                style="@style/SubtitleControl"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/player_sessions"
                android:padding="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/player_sessions_label" />
        </LinearLayout>

        <!--
            The media sessions readout, while turned on. A tap
            opens the notification access setting while that is missing; a
            long press copies the whole record.
        -->
        <TextView
            android:id="@+id/playerReadout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/hud_text_secondary"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
