<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient: 135° diagonal, three stops -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/card_dark"
                android:centerColor="@color/card_dark_dim"
                android:endColor="@color/hud_bg_bottom"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Border: 19% white, overlaid on gradient -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/hud_border" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
